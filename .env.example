# RabbitMQ
AMQP_URL=amqp://guest:guest@localhost:5672/
EXCHANGE=pixpro.events
EXCHANGE_TYPE=topic
QUEUE_NAME=pixpro.image.uploaded
ROUTING_KEY=image.uploaded

# SocketIO server
SOCKETIO_HOST=0.0.0.0
SOCKETIO_PORT=8765
CORS_ALLOWED_ORIGINS=*

# Keycloak — public JWKS validation (used by worker)
KEYCLOAK_JWKS_URL=http://localhost:8085/realms/pixpro-realm/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8085/realms/pixpro-realm
KEYCLOAK_AUDIENCE=pixpro-backend-client

# Keycloak — Integration Test Credentials (only used by tests/test_websocket_integration.py)
# IMPORTANT: Never commit actual secrets to version control.
KEYCLOAK_CLIENT_SECRET=your_client_secret_here
KEYCLOAK_TOKEN_URL=http://localhost:8085/realms/pixpro-realm/protocol/openid-connect/token
TEST_USER_USERNAME=meyer-test
TEST_USER_PASSWORD=meyer-test
